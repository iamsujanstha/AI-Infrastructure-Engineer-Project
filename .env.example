# Copy to .env for host-run applications. These credentials are local-only defaults.
NODE_ENV=development
DOCKER_SHARED_NETWORK=ai-infrastructure
API_PORT=4000
API_HOST=127.0.0.1
LOCAL_CHAT_CONTAINER_MODE=false
# Keep off for the role-based workspace; legacy chat has no employee identity isolation.
LEGACY_LOCAL_CHAT_ENABLED=false
LOG_LEVEL=info
DATABASE_URL=postgresql://platform:platform_dev_only@127.0.0.1:5432/local_ai_platform
POSTGRES_PASSWORD=platform_dev_only
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=pgadmin_dev_only_change_me
REDIS_URL=redis://127.0.0.1:6379
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=2000
PEOPLE_DB_TIMEOUT_MS=5000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
INFERENCE_HEALTH_URL=
INFERENCE_HEALTH_TIMEOUT_MS=2000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

CONTEXT_ENGINE_URL=http://127.0.0.1:8000
CONTEXT_ENGINE_PUBLIC_URL=http://127.0.0.1:8000
CONTEXT_ENGINE_TOKEN=context-engine-local-dev-token-change-before-use-32
CONTEXT_ENGINE_TIMEOUT_MS=1500
MLX_BASE_URL=http://127.0.0.1:8080
MLX_ALLOW_HOST_GATEWAY=false
MLX_DEFAULT_MODEL=mlx-community/Qwen3-8B-4bit
MLX_QWEN3_ENABLE_THINKING=false
MLX_TIMEOUT_MS=180000
MLX_CONTEXT_WINDOW_TOKENS=8192
MLX_MAX_OUTPUT_TOKENS=512

# Policy PDF RAG: model preparation is explicit; inference does not download weights.
POLICY_COMPUTE_TIMEOUT_MS=60000
POLICY_SMALL_MODEL=
POLICY_LARGE_MODEL=
# Experimental semantic reuse remains off until evaluated on the approved corpus.
POLICY_SEMANTIC_CACHE_ENABLED=false

# Optional organization OIDC. Register the callback with the provider; never paste secrets into chat.
# Google Workspace: https://accounts.google.com; leave blank until registered client is available.
OIDC_GOOGLE_WORKSPACE_DOMAIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Google endpoints: accounts.google.com,oauth2.googleapis.com,www.googleapis.com
OIDC_ALLOWED_HOSTS=
OIDC_REDIRECT_URI=http://127.0.0.1:4000/api/v1/cms/oidc/callback
OIDC_WEB_ORIGIN=http://127.0.0.1:3000

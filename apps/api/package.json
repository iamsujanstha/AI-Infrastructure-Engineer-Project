{
  "name": "@local-ai/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "predb:migrate": "npm run build",
    "db:migrate": "node dist/database/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "dotenv": "^17.2.4",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6"
  }
}

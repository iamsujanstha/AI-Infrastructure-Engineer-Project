# Copy to .env.docker and set the existing Docker network name and database credentials.
DOCKER_SHARED_NETWORK=replace-with-existing-network-name
DOCKER_DATABASE_URL=postgresql://platform:replace-me@postgres:5432/local_ai_platform
DOCKER_REDIS_URL=redis://redis:6379
DOCKER_CONTEXT_ENGINE_TOKEN=replace-with-a-random-secret-at-least-32-characters
DOCKER_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4000,http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
DOCKER_MLX_BASE_URL=http://host.docker.internal:8080

# Used only when you opt into the local-infra Compose profile instead of global services.
POSTGRES_PASSWORD=replace-me
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=replace-me
PGADMIN_PORT=5050
